<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Fullscreen Hardware Surface stretching 4:3 virtual display to full 3120x1440 AMOLED panel -->
    <SurfaceView
        android:id="@+id/surfaceStretch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Minimal exit button in top right corner -->
    <ImageButton
        android:id="@+id/btnExitStretch"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_floating"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Exit"
        android:alpha="0.4" />

    <!-- On-screen diagnostics: every pipeline step prints here so failures are visible -->
    <TextView
        android:id="@+id/tvStretchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:padding="8dp"
        android:text="StretchX başlatılıyor..."
        android:textColor="@color/neon_cyan"
        android:textSize="11sp"
        android:maxLines="8" />

</FrameLayout>
