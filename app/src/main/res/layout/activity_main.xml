<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_launcher"
        android:textColor="@color/neon_cyan"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/subtitle_launcher"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <!-- Shizuku Status Card -->
    <LinearLayout
        android:id="@+id/cardShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppSubtitle">

        <View
            android:id="@+id/indicatorShizuku"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/status_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shizuku_disconnected"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kablosuz Hata Ayıklama Köprüsü"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectShizuku"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect_shizuku"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Resolution Presets Card -->
    <LinearLayout
        android:id="@+id/cardPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardShizuku">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerilmiş Çözünürlük Profili"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb43Ultra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/preset_4_3_ultra"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rb43Fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preset_4_3_fps"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rb1610"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preset_16_10"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- Device Native Resolution Status -->
        <TextView
            android:id="@+id/tvDeviceNativeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_device_native_default"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />

        <!-- Overlay Toggle Switch (Default OFF for anti-cheat safety) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:text="@string/switch_overlay_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Detected Games Card -->
    <LinearLayout
        android:id="@+id/cardGames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintTop_toBottomOf="@id/cardPresets">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_detected_games"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGames"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Virtual Display Hardware Stretch Engine (Zero Black Bars) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLaunchVirtual"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button"
            android:text="@string/btn_launch_virtual"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Legacy System Level wm size Override -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:text="@string/btn_launch_wm"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEmergencyReset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_reset"
            android:text="@string/btn_emergency_reset"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
